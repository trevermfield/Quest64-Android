+                return false;
+            }
+
+            env->CallStaticVoidMethod(activity_class, open_method);
+            const bool ok = !env->ExceptionCheck();
+            if (!ok) {
+                env->ExceptionDescribe();
+                env->ExceptionClear();
+            }
+
+            env->DeleteLocalRef(activity_class);
+            env->DeleteLocalRef(activity);
+            return ok;
+        }
